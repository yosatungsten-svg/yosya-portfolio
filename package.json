{
  "name": "yosya-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Yosya Yodya — Finance Professional & Applied AI portfolio",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./dist/assets/style.css --minify",
    "build:html": "node scripts/build.js",
    "build": "node scripts/prepare-image.js && npm run build:html && npm run build:css",
    "dev": "node scripts/prepare-image.js && node scripts/build.js && tailwindcss -i ./src/styles/input.css -o ./dist/assets/style.css --watch",
    "screenshot": "node scripts/screenshot.js"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.13"
  },
  "allowScripts": {
    "sharp@0.33.5": true
  }
}
